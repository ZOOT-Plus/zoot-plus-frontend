{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["*.{jpg,gif,png,ico,svg,css,scss,js}"]
  },
  "routes": [
    {
      "route": "/sw.js",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/manifest.webmanifest",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/*.{jpg,gif,png,ico,svg,css,scss,js,webp,webmanifest}",
      "headers": {
        "cache-control": "public, max-age=604800, immutable"
      }
    }
  ]
}
